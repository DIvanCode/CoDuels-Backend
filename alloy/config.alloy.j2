logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ grafana_prometheus_remote_write_url }}"

    basic_auth {
      username = "{{ grafana_prometheus_username }}"
      password = "{{ grafana_api_key }}"
    }
  }
}

prometheus.scrape "production_apps" {
  targets = [
    {
      "__address__"      = "duely:5001",
      "__metrics_path__" = "/metrics",
      "env"              = "prod",
      "service"          = "duely",
      "instance"         = "duely",
    },
    {
      "__address__"      = "taski:9090",
      "__metrics_path__" = "/",
      "env"              = "prod",
      "service"          = "taski",
      "instance"         = "taski",
    },
    {
      "__address__"      = "coordinator:9090",
      "__metrics_path__" = "/",
      "env"              = "prod",
      "service"          = "exesh-coordinator",
      "instance"         = "coordinator",
    },
    {
      "__address__"      = "worker-1:9091",
      "__metrics_path__" = "/",
      "env"              = "prod",
      "service"          = "exesh-worker",
      "instance"         = "worker-1",
    },
    {
      "__address__"      = "worker-2:9092",
      "__metrics_path__" = "/",
      "env"              = "prod",
      "service"          = "exesh-worker",
      "instance"         = "worker-2",
    },
    {
      "__address__"      = "analyzer:8001",
      "__metrics_path__" = "/",
      "env"              = "prod",
      "service"          = "analyzer",
      "instance"         = "analyzer",
    },
    {
      "__address__"      = "alloy:12345",
      "__metrics_path__" = "/metrics",
      "env"              = "prod",
      "service"          = "alloy",
      "instance"         = "alloy",
    },
  ]

  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.exporter.unix "host" {
  procfs_path   = "/host/proc"
  sysfs_path    = "/host/sys"
  rootfs_path   = "/host/root"
  set_collectors = ["cpu", "meminfo", "filesystem"]
}

discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "env"
    replacement  = "prod"
  }
  rule {
    target_label = "service"
    replacement  = "host"
  }
}

prometheus.scrape "production_host" {
  targets         = discovery.relabel.host_metrics.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "coduels"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(coordinator|worker-[0-9]+)"
    replacement   = "exesh"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
}

loki.source.docker "docker" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = {
    "env"      = "prod",
    "platform" = "docker",
  }
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.normalize.receiver]
}

loki.process "normalize" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.match {
    selector = "{service_name=~\"taski|coordinator|worker-[0-9]+\"}"
    stage.json {
      expressions = { level = "level" }
    }
    stage.labels {
      values = { level = "level" }
    }
  }

  stage.match {
    selector = "{service_name=\"duely\"}"
    stage.json {
      expressions = { level = "LogLevel" }
    }
    stage.labels {
      values = { level = "level" }
    }
  }

  stage.match {
    selector = "{service_name=\"analyzer\"}"
    stage.regex {
      expression = "^(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL):"
    }
    stage.labels {
      values = { level = "level" }
    }
  }

  stage.match {
    selector = "{service_name=\"nginx\"}"
    stage.regex {
      expression = "\\[(?P<level>error|crit|alert|emerg)\\]"
    }
    stage.labels {
      values = { level = "level" }
    }
  }

  stage.match {
    selector = "{service_name=\"caddy\"}"
    stage.json {
      expressions = { level = "level" }
    }
    stage.labels {
      values = { level = "level" }
    }
  }

  stage.match {
    selector = "{service_name=\"alloy\"}"
    stage.regex {
      expression = "level=(?P<level>error|warn|info|debug)"
    }
    stage.labels {
      values = { level = "level" }
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = "{{ grafana_loki_push_url }}"

    basic_auth {
      username = "{{ grafana_loki_username }}"
      password = "{{ grafana_api_key }}"
    }
  }
}
